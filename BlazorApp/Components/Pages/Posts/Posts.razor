@page "/posts"
@inject IPostService PostService
@inject NavigationManager NavMgr

<PageTitle>Posts</PageTitle>

<h1>Posts</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width: 300px" placeholder="Filter by title" @bind="titleFilter"/>
    <button class="btn btn-secondary" @onclick="LoadAsync">Search</button>
    <AuthorizeView>
        <Authorized>
            <button class="btn btn-primary" @onclick='() => NavMgr.NavigateTo("posts/create")'>New post</button>
        </Authorized>
    </AuthorizeView>
</div>

@if (!string.IsNullOrEmpty(errorLabel))
{
    <p style="color: red">@errorLabel</p>
}

@if (posts is null)
{
    <p>Loading...</p>
}
else if (posts.Count == 0)
{
    <p>No posts yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (PostDto post in posts)
        {
            <li class="list-group-item">
                <a href="posts/@post.Id">@post.Title</a>
                <span class="text-muted"> by @post.Username</span>
            </li>
        }
    </ul>
}

@code {
    private List<PostDto>? posts;
    private string titleFilter = "";
    private string errorLabel = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorLabel = "";
        try
        {
            posts = await PostService.GetPostsAsync(titleFilter);
        }
        catch (Exception e)
        {
            posts = new List<PostDto>();
            errorLabel = $"Error: {e.Message}";
        }
    }
}
